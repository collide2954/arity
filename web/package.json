{
  "name": "arity-web",
  "version": "0.1.0",
  "private": true,
  "description": "The website of arity: values that open-access research articles report, with their sources.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
